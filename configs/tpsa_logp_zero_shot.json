{
  "project": "qwen_flash_tpsa_logp_zero_shot",
  "seed": 42,
  "dataset": {
    "train": "outputs/processed/guacamol_full/train.csv",
    "validation": "outputs/processed/guacamol_full/val.csv",
    "properties": [
      "logp",
      "tpsa",
      "sas",
      "qed"
    ]
  },
  "model": {
    "model_id": "Qwen/Qwen3.8-Flash-Next",
    "trust_remote_code": true,
    "dtype": "bfloat16",
    "device_map": "auto",
    "local_files_only": false,
    "auto_model_class": "AutoModelForImageTextToText"
  },
  "experiments": {
    "tpsa_logp": [
      "tpsa",
      "logp"
    ]
  },
  "targets": {
    "targets_per_experiment": 9,
    "single_property_quantiles": [
      0.2,
      0.4,
      0.6,
      0.8
    ],
    "fixed_targets": {
      "tpsa_logp": [
        {
          "tpsa": 40.0,
          "logp": 2.0
        },
        {
          "tpsa": 40.0,
          "logp": 4.0
        },
        {
          "tpsa": 40.0,
          "logp": 6.0
        },
        {
          "tpsa": 80.0,
          "logp": 2.0
        },
        {
          "tpsa": 80.0,
          "logp": 4.0
        },
        {
          "tpsa": 80.0,
          "logp": 6.0
        },
        {
          "tpsa": 120.0,
          "logp": 2.0
        },
        {
          "tpsa": 120.0,
          "logp": 4.0
        },
        {
          "tpsa": 120.0,
          "logp": 6.0
        }
      ]
    }
  },
  "generation": {
    "shots": 0,
    "replicates_per_target": 1,
    "generations_per_replicate": 25,
    "temperature": 0.7,
    "top_p": 0.95,
    "max_new_tokens": 128,
    "do_sample": true,
    "repetition_penalty": 1.0,
    "generations_per_replicate_by_target": [
      12,
      11,
      11,
      11,
      11,
      11,
      11,
      11,
      11
    ]
  },
  "evaluation": {
    "tolerances": {
      "logp": 0.5,
      "tpsa": 10.0,
      "sas": 0.5,
      "qed": 0.05
    }
  },
  "paths": {
    "target_manifest": "manifests/tpsa_logp_zero_shot_targets.json",
    "job_manifest": "manifests/tpsa_logp_zero_shot_jobs.jsonl",
    "generation_output": "outputs/raw/qwen_flash_tpsa_logp_zero_shot.jsonl",
    "smoke_output": "outputs/raw/qwen_flash_tpsa_logp_zero_shot_smoke_test.jsonl",
    "evaluation_root": "outputs/evaluation/flash_tpsa_logp_zero_shot",
    "aggregate_output": "outputs/evaluation/flash_tpsa_logp_zero_shot/aggregate"
  },
  "vllm": {
    "tensor_parallel_size": 1,
    "max_model_len": 4096,
    "max_num_seqs": 2,
    "max_num_batched_tokens": 2048,
    "batch_size": 2,
    "gpu_memory_utilization": 0.9,
    "cpu_offload_gb": 0,
    "language_model_only": true,
    "enable_prefix_caching": true,
    "model_id": "Inferact/Qwen3.8-Flash-Next-NVFP4",
    "dtype": "auto",
    "min_vllm_version": "0.30.0",
    "default_minimum_gpu_memory_gb": 130,
    "engram_config": {
      "cpu_offload": true
    },
    "minimum_available_host_memory_gb": 51.0
  },
  "target_seed_offset": 5
}
