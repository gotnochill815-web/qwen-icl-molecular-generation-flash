{
  "project": "qwen_flash_molecular_generation",
  "seed": 42,
  "dataset": {
    "train": "outputs/processed/guacamol_full/train.csv",
    "validation": "outputs/processed/guacamol_full/val.csv",
    "properties": [
      "logp",
      "tpsa",
      "sas",
      "qed"
    ]
  },
  "model": {
    "model_id": "Qwen/Qwen3.8-Flash-Next",
    "trust_remote_code": true,
    "dtype": "bfloat16",
    "device_map": "auto",
    "local_files_only": false
  },
  "experiments": {
    "logp": [
      "logp"
    ],
    "tpsa": [
      "tpsa"
    ],
    "sas": [
      "sas"
    ],
    "qed": [
      "qed"
    ],
    "tpsa_sas": [
      "tpsa",
      "sas"
    ],
    "sas_logp": [
      "sas",
      "logp"
    ],
    "logp_sas_tpsa": [
      "logp",
      "sas",
      "tpsa"
    ],
    "tpsa_logp": [
      "tpsa",
      "logp"
    ]
  },
  "targets": {
    "targets_per_experiment": 4,
    "single_property_quantiles": [
      0.2,
      0.4,
      0.6,
      0.8
    ]
  },
  "generation": {
    "shots": 0,
    "replicates_per_target": 1,
    "generations_per_replicate": 25,
    "temperature": 0.7,
    "top_p": 0.95,
    "max_new_tokens": 128,
    "do_sample": true,
    "repetition_penalty": 1.0
  },
  "evaluation": {
    "tolerances": {
      "logp": 0.5,
      "tpsa": 10.0,
      "sas": 0.5,
      "qed": 0.05
    }
  },
  "paths": {
    "target_manifest": "manifests/flash_zero_shot_targets.json",
    "job_manifest": "manifests/flash_zero_shot_jobs.jsonl",
    "generation_output": "outputs/raw/qwen_flash_zero_shot.jsonl",
    "smoke_output": "outputs/raw/qwen_flash_smoke_test.jsonl"
  },
  "vllm": {
    "tensor_parallel_size": 1,
    "max_model_len": 4096,
    "max_num_seqs": 4,
    "max_num_batched_tokens": 4096,
    "batch_size": 4,
    "gpu_memory_utilization": 0.9,
    "cpu_offload_gb": 0,
    "language_model_only": true,
    "enable_prefix_caching": true,
    "required_total_gpu_memory_gb": 423
  }
}
